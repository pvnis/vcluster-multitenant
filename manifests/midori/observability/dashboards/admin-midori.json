   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "stat",
   "title": "Broker table_full (10m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(gpusched_table_full_total[10m]))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "description": "> 0: the driver broker ran out of group slots and time-slicing is NOT enforced for new contexts.",
   "id": 3,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 5
   }
  },
  {
   "type": "stat",
