  {
   "type": "table",
   "title": "Quota use by tenant",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (namespace, resource) (kube_resourcequota{type=\"used\", namespace=~\"tenant-.+\"}) / on (namespace, resource) max by (namespace, resource) (kube_resourcequota{type=\"hard\", namespace=~\"tenant-.+\"})",
     "format": "table",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "used / hard"
      }
     }
    }
   ],
   "id": 17,
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   }
