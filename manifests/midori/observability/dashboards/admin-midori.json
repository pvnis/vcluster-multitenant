  {
   "type": "stat",
   "title": "runsc-gpu-scheduler down",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
