    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(midori_systemd_unit_active{unit=\"runsc-gpu-scheduler\"} == 0) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
