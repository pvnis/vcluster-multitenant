{
 "uid": "tenant-serving",
 "title": "Model serving (vLLM)",
 "tags": [
  "midori",
  "tenant",
  "vllm"
 ],
 "schemaVersion": 39,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "Load",
   "id": 2,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "timeseries",
   "title": "Requests running / waiting",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model_name) (vllm:num_requests_running)",
     "legendFormat": "running {{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (model_name) (vllm:num_requests_waiting)",
     "legendFormat": "waiting {{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 3,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "KV cache usage",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (model_name) (vllm:kv_cache_usage_perc)",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "description": "Of the KV cache vLLM sized against its GPU memory SLICE, not the whole card.",
   "id": 4,
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Requests finished",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model_name, finished_reason) (rate(vllm:request_success_total[5m]))",
     "legendFormat": "{{model_name}} {{finished_reason}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 5,
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "row",
   "title": "Latency",
   "id": 6,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "timeseries",
   "title": "Time to first token",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, model_name) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
     "legendFormat": "p50 {{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
     "legendFormat": "p95 {{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "End-to-end request latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, model_name) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))",
     "legendFormat": "p50 {{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))",
     "legendFormat": "p95 {{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 8,
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "row",
   "title": "Throughput",
   "id": 9,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "timeseries",
   "title": "Tokens per second",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model_name) (rate(vllm:generation_tokens_total[5m]))",
     "legendFormat": "generated {{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (model_name) (rate(vllm:prompt_tokens_total[5m]))",
     "legendFormat": "prompt {{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 10,
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Prefix cache hit rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model_name) (rate(vllm:prefix_cache_hits_total[5m])) / sum by (model_name) (rate(vllm:prefix_cache_queries_total[5m]))",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 11,
   "gridPos": {
    "x": 12,
    "y": 19,
    "w": 12,
    "h": 8
   }
  }
 ]
}