[Unit]
Description=runsc GPU scheduler (AMD time-slicing coordinator)
Before=k3s.service

[Service]
# AMD: no --runlist-control (amdproxy drives DBG_TRAP itself).
ExecStart=/usr/local/bin/runsc gpu-scheduler --socket /run/runsc-gpu-scheduler.sock --measure-usage=false
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
